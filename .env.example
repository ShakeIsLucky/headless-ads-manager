# Meta Marketing API credentials — copy this file to .env and fill in.
# Get a token from the Graph API Explorer or your own app:
#   https://developers.facebook.com/tools/explorer/
# Required scopes: ads_read (reads) and ads_management (writes).

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0

# Optional
META_APP_ID=
META_APP_SECRET=
META_PIXEL_ID=
META_BUSINESS_ID=

# GLOBAL SAFETY SWITCH — leave true unless you really mean to write.
# Even with SAFE_MODE=false, each write also needs apply=True in code.
SAFE_MODE=true
